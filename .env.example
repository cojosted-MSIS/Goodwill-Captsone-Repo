# Copy this file to .env and fill in your own values. Never commit .env.
# Names follow docs/reference/reallms/REALLMS_GUIDE.md.

# Your personal REALLMS API key, created on the RT Projects allocation page.
# Needed only when config/settings.yaml has parser: reallms. Keys from the REALLMS Chat site do not work.
LLM_API_KEY=replace-with-your-key

# Key for the open-draft match check (add-existing-client-updates): a long random value.
# Required when config/settings.yaml has retention mode: production. In demo mode, a random
# key is made in memory for each run when this is not set. Never commit a real key.
# INTAKE_MATCH_KEY=replace-with-a-long-random-value

# Optional. Defaults come from config/settings.yaml.
# LLM_BASE_URL=https://reallms.rescloud.iu.edu/direct/v1
# LLM_MODEL=gemma-4-31B-it

# Private keys that open notes sealed on a worker's device (add-web-application). Base64 PKCS#8, RSA of at
# least 3072 bits, separated by commas, newest first; keep an old key for at least 72 hours after rotating so
# no queued note is stranded. Make one with: python scripts/make_seal_key.py (it adds the key to .env and prints
# only its key ID). Required when retention mode is production. In demo mode, when this is not set, a key is made
# in memory for each run, so notes saved on a device do not survive a server restart. Never commit a real key.
# INTAKE_SEAL_PRIVATE_KEYS=<base64-private-key>,<older-base64-private-key>

# Web sign-in for the synthetic demo accounts in config/users.yaml (add-web-application).
# Choose your own passwords in .env. Only a salted scrypt hash is kept, in memory, and the
# passwords are never logged or committed. An account whose variable is not set cannot sign in.
# DEMO_PASSWORD_J_ALVAREZ=replace-with-your-own-password
# DEMO_PASSWORD_M_CHEN=replace-with-your-own-password
# DEMO_PASSWORD_SUPERVISOR=replace-with-your-own-password
# DEMO_PASSWORD_STAFF=replace-with-your-own-password
