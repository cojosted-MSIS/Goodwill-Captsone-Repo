# Copy this file to .env and fill in your own values. Never commit .env.

# REALLMS (IU-hosted LLM service) API key. Needed only when config/settings.yaml has parser: reallms.
REALLMS_API_KEY=replace-with-your-key

# Optional: use a different REALLMS model for this run (overrides settings.yaml).
# REALLMS_MODEL=gpt-oss-120b
